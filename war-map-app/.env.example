# Copy to .env and fill in. Both are optional: without them the app still
# works, just without Claude feedback / Google Calendar.

# Claude feedback and "read it from a screenshot" (console.anthropic.com → API keys).
# This key is bundled into the app — keep the build to yourself and set a spend limit.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Google Calendar: an OAuth client of type "iOS" with bundle ID com.balkisa.warmap
# (Google Cloud Console → APIs & Services → Credentials). Looks like
# 1234567890-abc123.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
